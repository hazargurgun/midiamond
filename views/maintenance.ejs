    <title>Bakımdayız | MI DIAMOND</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="MI DIAMOND kısa süreliğine bakımda. Çok yakında tekrar buradayız.">
    <link rel="icon" type="image/png" href="/assets/img/logo/custom_logo_v2.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #140c40;
            --gold: #c49b45;
            --gold-soft: #d4af37;
            --cream: #f7f4ee;
            --muted: #6b6578;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { min-height: 100%; }
        body {
            font-family: Inter, system-ui, sans-serif;
            background:
                radial-gradient(1200px 600px at 50% -10%, rgba(196, 155, 69, 0.16), transparent 55%),
                linear-gradient(180deg, #fbfaf6 0%, var(--cream) 100%);
            color: var(--navy);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 32px 20px;
        }
        .card {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .logo-wrap {
            width: 168px;
            margin: 0 0 24px;
            line-height: 0;
        }
        .logo-wrap img {
            display: block;
            width: 100%;
            height: auto;
        }
        .rule {
            width: 40px;
            height: 1px;
            background: var(--gold);
            margin: 0 0 22px;
            flex-shrink: 0;
        }
        h1 {
            font-family: "Cormorant Garamond", Georgia, serif;
            font-size: clamp(32px, 6vw, 46px);
            font-weight: 600;
            letter-spacing: 0.04em;
            padding-left: 0.04em;
            margin: 0 0 14px;
            line-height: 1.15;
        }
        p.lead {
            color: var(--muted);
            font-size: 16px;
            line-height: 1.7;
            max-width: 400px;
            margin: 0 0 28px;
        }
        .badge {
            display: inline-block;
            border: 1px solid rgba(196, 155, 69, 0.45);
            color: var(--gold);
            letter-spacing: 0.18em;
            padding-left: calc(14px + 0.18em);
            text-transform: uppercase;
            font-size: 11px;
            font-weight: 500;
            padding-top: 8px;
            padding-bottom: 8px;
            padding-right: 14px;
            border-radius: 999px;
            margin: 0 0 20px;
        }
        .wp-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #25d366;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            line-height: 1;
            padding: 14px 24px;
            border-radius: 999px;
            margin: 0 0 28px;
            box-shadow: 0 8px 22px rgba(37, 211, 102, 0.28);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .wp-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 26px rgba(37, 211, 102, 0.38);
            color: #fff;
        }
        .wp-btn svg {
            display: block;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }
        .details {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .details a {
            display: grid;
            grid-template-columns: 36px minmax(0, 1fr);
            column-gap: 12px;
            align-items: center;
            color: var(--navy);
            text-decoration: none;
            text-align: left;
        }
        .details a:hover { color: var(--gold); }
        .details a:hover .icon { border-color: var(--gold); }
        .icon {
            width: 36px;
            height: 36px;
            border: 1px solid rgba(196, 155, 69, 0.4);
            border-radius: 50%;
            display: grid;
            place-items: center;
            color: var(--gold);
            line-height: 0;
        }
        .icon svg {
            display: block;
            width: 16px;
            height: 16px;
            overflow: visible;
        }
        .meta {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 3px;
            min-width: 0;
        }
        .label {
            display: block;
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--gold);
            font-weight: 500;
            line-height: 1;
        }
        .value {
            display: block;
            color: inherit;
            font-size: 14px;
            line-height: 1.45;
        }
    </style>
</head>
